# Optional approved LLM providers. The app defaults to local deterministic mode.
# Configure either (or both) to unlock "Claude" / "Azure OpenAI" as a choice for
# Generate draft (Report studio) and for revisions (Feedback & revisions tab).
# Either way, tick the consent checkbox before use. Only masked section text,
# your feedback, and minimised metrics/theme evidence are sent -- raw learner
# comments never leave the device.

# Claude (Anthropic) -- get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional startup CSV or folder of course export CSVs; relative paths resolve
# from the application folder. Leave blank to auto-detect data/client/ (a real
# client export drop) and fall back to the included synthetic demo data.
EVALUATION_DATA_PATH=

# Optional path to a university/institution logo image (PNG/JPG) placed in the
# top-right of every exported .docx report. Leave blank for a text placeholder.
UNIVERSITY_LOGO_PATH=
